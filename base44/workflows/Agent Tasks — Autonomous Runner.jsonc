{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_tasks_runner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_tasks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAgentTasks"
          },
          "then": "end",
          "x-base44": {
            "title": "Run agent tasks",
            "description": "Low risk auto, high risk held"
          }
        }
      }
    ]
  },
  "name": "Agent Tasks \u2014 Autonomous Runner",
  "description": "Every 15 minutes, agents work through queued and approved tasks; high-risk tasks are held for approval",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}