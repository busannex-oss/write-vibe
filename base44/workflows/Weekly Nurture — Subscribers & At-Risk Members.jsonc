{
  "description": "Every Tuesday at 9am, emails newsletter subscribers who never joined and members at risk of leaving, and re-enriches their CRM profiles.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 2",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_nurture_cycle",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_nurture": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nurtureContacts",
            "args": {
              "track": "all",
              "limit": 25
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Nurture contacts",
            "description": "Email + re-enrich"
          }
        }
      }
    ]
  },
  "name": "Weekly Nurture \u2014 Subscribers & At-Risk Members"
}