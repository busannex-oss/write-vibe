{
  "name": "New Blog Post \u2014 Email Subscribers",
  "description": "When a blog post is published (manually or by the scheduler), emails a summary to all active newsletter subscribers.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "BlogPost",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"published\" and ((.trigger.old_data // {}).status // \"\") != \"published\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_post_newsletter",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_newsletter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNewPostNewsletter",
            "args": {
              "post_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email subscribers",
            "description": "New post summary"
          }
        }
      }
    ]
  }
}