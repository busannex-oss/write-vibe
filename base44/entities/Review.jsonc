{
  "name": "Review",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Associated book ID"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "rating": {
      "type": "number",
      "description": "Star rating (1-5)",
      "minimum": 1,
      "maximum": 5
    },
    "title": {
      "type": "string",
      "description": "Review title/headline"
    },
    "content": {
      "type": "string",
      "description": "Review text/testimonial"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Pin this review to show on website"
    }
  },
  "required": [
    "book_id",
    "author_name",
    "rating",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}