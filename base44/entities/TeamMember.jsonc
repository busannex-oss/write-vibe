{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "author",
        "co_author",
        "editor",
        "publisher",
        "marketing",
        "assistant"
      ],
      "description": "Team member role"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "inactive"
      ],
      "default": "invited"
    }
  },
  "required": [
    "book_id",
    "user_email",
    "role"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}