{
  "name": "SocialCredential",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "linkedin"
      ],
      "description": "Social platform these credentials belong to"
    },
    "access_token": {
      "type": "string",
      "description": "Long-lived access token"
    },
    "account_id": {
      "type": "string",
      "description": "Facebook Page ID, Instagram Business Account ID, or LinkedIn URN"
    },
    "label": {
      "type": "string",
      "description": "Friendly name for the connected account"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "platform",
    "access_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}