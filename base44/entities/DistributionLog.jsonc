{
  "name": "DistributionLog",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "kdp",
        "acx"
      ],
      "description": "Distribution platform"
    },
    "action": {
      "type": "string",
      "description": "What was pushed/updated"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "pending"
    },
    "metadata_snapshot": {
      "type": "object",
      "description": "Snapshot of metadata at time of push",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "price": {
          "type": "number"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Validation errors at time of push"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "book_id",
    "platform",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}