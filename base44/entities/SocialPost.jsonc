{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "caption": {
      "type": "string",
      "description": "Marketing snippet text to publish"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image to publish with the post"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "facebook",
          "instagram",
          "linkedin"
        ]
      },
      "description": "Platforms to publish this post to"
    },
    "book_id": {
      "type": "string",
      "description": "Associated book ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "posted",
        "failed"
      ],
      "default": "queued"
    },
    "posted_at": {
      "type": "string",
      "description": "When the post was published"
    },
    "post_results": {
      "type": "string",
      "description": "JSON string of per-platform results/errors from the last attempt"
    }
  },
  "required": [
    "caption",
    "platforms"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}