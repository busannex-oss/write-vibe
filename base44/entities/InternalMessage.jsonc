{
  "name": "InternalMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Conversation thread ID \u2014 typically the user's ID"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "agent",
        "user"
      ],
      "description": "Who sent the message"
    },
    "sender_id": {
      "type": "string",
      "description": "Agent ID or user ID"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID or agent ID"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name of the recipient"
    },
    "agent_id": {
      "type": "string",
      "default": "master_customer_service",
      "description": "Which agent this message belongs to"
    },
    "content": {
      "type": "string",
      "description": "Message body"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has read the message"
    }
  },
  "required": [
    "thread_id",
    "sender_type",
    "sender_id",
    "sender_name",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_type": "user",
          "data.sender_id": "{{user.id}}",
          "data.thread_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "data.thread_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "data.thread_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}