{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Associated book ID"
    },
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "subscribed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed"
      ],
      "default": "active"
    }
  },
  "required": [
    "book_id",
    "email"
  ]
}