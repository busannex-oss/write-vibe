{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title"
    },
    "slug": {
      "type": "string",
      "description": "URL slug, unique"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary used in listings and social shares"
    },
    "content": {
      "type": "string",
      "description": "Post body (markdown)"
    },
    "cover_image_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_book_id": {
      "type": "string",
      "description": "Book this post promotes, if any"
    },
    "cta_headline": {
      "type": "string",
      "description": "Newsletter CTA headline shown at the end of the post"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published"
      ],
      "default": "draft"
    },
    "scheduled_for": {
      "type": "string",
      "description": "ISO datetime when a scheduled post should automatically go live"
    },
    "published_at": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}