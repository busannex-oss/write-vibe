{
  "name": "DashboardTask",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this task belongs to"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "What to do"
    },
    "link_page": {
      "type": "string",
      "description": "Page name to navigate to for this task"
    },
    "source": {
      "type": "string",
      "default": "system",
      "description": "Who created this task (e.g. sherry_onboarding)"
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}