{
  "name": "MissionStatement",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The mission statement text"
    },
    "version_number": {
      "type": "number",
      "description": "Version number (e.g. 1, 2, 3)"
    },
    "publish_date": {
      "type": "string",
      "format": "date",
      "description": "Date this version was published"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the active/current mission statement"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether this mission statement is publicly visible"
    },
    "change_rationale": {
      "type": "string",
      "description": "Why this version was created / what changed"
    },
    "pillar_scores": {
      "type": "array",
      "description": "Alignment scores against each brand pillar",
      "items": {
        "type": "object",
        "properties": {
          "pillar_name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "alignment_analysis": {
      "type": "string",
      "description": "AI-generated alignment analysis from Google AI Studio"
    },
    "overall_alignment_score": {
      "type": "number",
      "description": "Average score across all pillars"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "pending",
        "analyzing",
        "complete",
        "error"
      ],
      "default": "pending"
    }
  },
  "required": [
    "text",
    "version_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}