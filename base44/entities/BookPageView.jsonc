{
  "name": "BookPageView",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Book whose public page was viewed"
    },
    "book_title": {
      "type": "string",
      "description": "Book title at the time of the visit"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the author who owns the book"
    },
    "source": {
      "type": "string",
      "description": "Where the visitor came from (direct, search, social, referral)"
    },
    "referrer": {
      "type": "string",
      "description": "Raw referring URL, if any"
    },
    "session_id": {
      "type": "string",
      "description": "Anonymous per-browser-session id used to count unique visitors"
    },
    "viewed_at": {
      "type": "string",
      "description": "ISO timestamp of the visit"
    }
  },
  "required": [
    "book_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}